<report-config>
  <report>
    <file-name>{date}-federation-stats.txt</file-name>
    <delim>{tab}</delim>
    <filters/>
    <query>
      <pattern>Coherence:type=Federation,responsibility=Coordinator,*</pattern>
    </query>
    <row>
      <column id="PendingIncomingMessageCount">
        <type>method</type>
        <name>retrievePendingIncomingMessages</name>
      </column>
      <column id="PendingOutgoingMessageCount">
        <type>method</type>
        <name>retrievePendingOutgoingMessages</name>
      </column>
      <column id="NonFederatedCaches">
        <type>method</type>
        <name>listNonFederatedCaches</name>
        <delim>,</delim>
      </column>
    </row>
  </report>
</report-config>
