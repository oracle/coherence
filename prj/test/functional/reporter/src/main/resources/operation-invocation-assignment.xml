<report-config>
  <report>
    <file-name>{date}-federation-stats.txt</file-name>
    <delim>{tab}</delim>
    <filters/>
    <query>
      <pattern>Coherence:type=PartitionAssignment,*</pattern>
    </query>
    <row>
      <column id="ScheduledDistributions">
        <type>method</type>
        <name>reportScheduledDistributions</name>
        <init-params>
          <init-param>
            <param-type>boolean</param-type>
            <param-value>true</param-value>
          </init-param>
        </init-params>
        <delim>,</delim>
      </column>
    </row>
  </report>
</report-config>
