<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.oracle.coherence.ce.tests</groupId>
    <artifactId>coherence-functional-tests</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>net</artifactId>
  <name>Coherence Net Tests</name>

  <profiles>
    <profile>
      <id>stage5</id>
      <properties>
        <skipTests>false</skipTests>
        <skip.native.build>false</skip.native.build>
        <skip.native.tests>false</skip.native.tests>
      </properties>
    </profile>
  </profiles>

  <properties>
    <testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${coherence.group.id}</groupId>
      <artifactId>coherence-testing-support</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${coherence.group.id}</groupId>
      <artifactId>coherence-testing-data</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${coherence.group.id}</groupId>
      <artifactId>coherence</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>gar-fixture</id>
            <phase>process-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <skip>false</skip>
              <target>
                <delete file="${project.build.outputDirectory}/META-INF/coherence-application.xml"/>
                <delete file="${project.build.outputDirectory}/coh_new_examples.gar"/>
                <zip destfile="${project.build.outputDirectory}/coh_new_examples.gar">
                  <zipfileset dir="${project.basedir}/src/main/gar"/>
                  <zipfileset file="${project.basedir}/src/main/resources/coherence-cache-config.xml"
                              fullpath="META-INF/coherence-cache-config.xml"/>
                  <zipfileset file="${project.basedir}/src/main/resources/override-cache-config.xml"
                              fullpath="override-cache-config.xml"/>
                  <zipfileset file="${project.basedir}/src/main/resources/META-INF/coherence/security-config.xml"
                              fullpath="META-INF/coherence/security-config.xml"/>
                </zip>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
          <groupId>com.oracle.coherence.moditect</groupId>
          <artifactId>moditect-maven-plugin</artifactId>
          <version>${maven.moditect.plugin.version}</version>
          <executions>
            <execution>
              <id>add-module-info</id>
              <phase>package</phase>
              <goals>
                <goal>add-module-info</goal>
              </goals>
              <configuration combine.self="append">
                <module>
                  <moduleInfo>
                    <!--
                     The test runner needs the data module. ServiceTests uses
                     a classpath server to exclude the data JAR independently.
                     -->
                    <requires>
                      com.oracle.coherence.testing.data;
                    </requires>
                  </moduleInfo>
                </module>
              </configuration>
            </execution>
          </executions>
      </plugin>

      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <extensions>true</extensions>
        </plugin>
      </plugins>
  </build>
</project>
