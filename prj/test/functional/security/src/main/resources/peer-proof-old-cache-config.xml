<cache-config xmlns="http://xmlns.oracle.com/coherence/coherence-cache-config">
  <caching-scheme-mapping>
    <cache-mapping>
      <cache-name>*</cache-name>
      <scheme-name>old-distributed</scheme-name>
    </cache-mapping>
  </caching-scheme-mapping>
  <caching-schemes>
    <distributed-scheme>
      <scheme-name>old-distributed</scheme-name>
      <service-name>PEER01OldService</service-name>
      <backing-map-scheme><local-scheme/></backing-map-scheme>
      <autostart>true</autostart>
    </distributed-scheme>
  </caching-schemes>
</cache-config>
