<cache-config xmlns="http://xmlns.oracle.com/coherence/coherence-cache-config"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.oracle.com/coherence/coherence-cache-config coherence-cache-config.xsd">
  <caching-scheme-mapping>
    <cache-mapping>
      <cache-name>orders</cache-name>
      <scheme-name>orders</scheme-name>
    </cache-mapping>
  </caching-scheme-mapping>
  <caching-schemes>
    <distributed-scheme>
      <scheme-name>orders</scheme-name>
      <service-name>OrdersService</service-name>
      <partition-count>17</partition-count>
      <backup-count>1</backup-count>
      <backup-storage><type>journal</type></backup-storage>
      <backing-map-scheme><journal-scheme/></backing-map-scheme>
      <persistence><environment>orders-journal</environment></persistence>
      <autostart>true</autostart>
    </distributed-scheme>
  </caching-schemes>
</cache-config>
