<coherence xmlns="http://xmlns.oracle.com/coherence/coherence-operational-config"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://xmlns.oracle.com/coherence/coherence-operational-config coherence-operational-config.xsd">
  <cluster-config>
    <persistence-environments>
      <persistence-environment id="orders-journal">
        <persistence-mode>active-backup</persistence-mode>
        <persistence-type>journal</persistence-type>
        <active-directory system-property="test.sparse.active">target/sparse-active</active-directory>
        <backup-directory system-property="test.sparse.backup">target/sparse-backup</backup-directory>
        <snapshot-directory system-property="test.sparse.snapshot">target/sparse-snapshot</snapshot-directory>
        <trash-directory system-property="test.sparse.trash">target/sparse-trash</trash-directory>
      </persistence-environment>
    </persistence-environments>
  </cluster-config>
</coherence>
