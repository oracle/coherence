<security-config xmlns="http://xmlns.oracle.com/coherence/coherence-security-config" version="1.0">
  <allowed-classes>
    <class name="java.security.SignedObject" source="manual"/>
    <class name="javax.security.auth.x500.X500Principal" source="manual"/>
    <class name="java.security.cert.Certificate$CertificateRep" source="manual"/>
