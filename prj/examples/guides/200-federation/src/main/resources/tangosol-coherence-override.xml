<coherence xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://xmlns.oracle.com/coherence/coherence-operational-config"
           xsi:schemaLocation="http://xmlns.oracle.com/coherence/coherence-operational-config coherence-operational-config.xsd">

  <cluster-config>
    <lambdas-serialization>static</lambdas-serialization>
  </cluster-config>

  <!-- To enable jmx connections -->
  <management-config>
    <managed-nodes system-property="coherence.management">all</managed-nodes>
  </management-config>

  <!--
  Define a federation configuration for PrimaryCluster and SecondaryCluster
  where the default topology is Active-Active, but we have specifically
  defined this for clarity.
  -->
  <!-- tag::mapping[] -->
  <federation-config>
    <participants>
      <participant>  <!--1-->
        <name system-property="test.primary.cluster.name">ClusterA</name>
        <participant-destinations>
          <participant-destination>
            <name>direct</name>
            <remote-addresses>
              <socket-address>
                <address>127.0.0.1</address>
                <port system-property="federation.primary.port">40000</port>
              </socket-address>
            </remote-addresses>
          </participant-destination>
        </participant-destinations>
      </participant>
      <participant>  <!--2-->
        <name system-property="test.secondary.cluster.name">ClusterB</name>
        <participant-destinations>
          <participant-destination>
            <name>direct</name>
            <remote-addresses>
              <socket-address>
                <address>127.0.0.1</address>
                <port system-property="federation.secondary.port">40001</port>
              </socket-address>
            </remote-addresses>
          </participant-destination>
        </participant-destinations>
      </participant>
    </participants>
    <topology-definitions>  <!--3-->
      <active-active>
        <name>MyTopology</name>
        <active system-property="test.primary.cluster.name">ClusterA</active>
        <active system-property="test.secondary.cluster.name">ClusterB</active>
      </active-active>
    </topology-definitions>
  </federation-config>
  <!-- end::mapping[] -->
</coherence>
