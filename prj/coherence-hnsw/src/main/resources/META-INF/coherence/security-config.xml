<security-config xmlns="http://xmlns.oracle.com/coherence/coherence-security-config"
                 version="1.0">
  <allowed-classes>
    <class name="com.oracle.coherence.ai.hnsw.HnswIndex" source="manual" executable="true"/>
    <class name="com.oracle.coherence.hnswlib.SpaceName" source="manual"/>
    <class name="com.oracle.coherence.hnswlib.exception.IndexAlreadyInitializedException" source="manual"/>
    <class name="com.oracle.coherence.hnswlib.exception.IndexNotInitializedException" source="manual"/>
    <class name="com.oracle.coherence.hnswlib.exception.ItemCannotBeInsertedIntoTheVectorSpaceException" source="manual"/>
    <class name="com.oracle.coherence.hnswlib.exception.OnceIndexIsClearedItCannotBeReusedException" source="manual"/>
    <class name="com.oracle.coherence.hnswlib.exception.QueryCannotReturnResultsException" source="manual"/>
    <class name="com.oracle.coherence.hnswlib.exception.UnableToCreateNewIndexInstanceException" source="manual"/>
    <class name="com.oracle.coherence.hnswlib.exception.UnexpectedNativeException" source="manual"/>
  </allowed-classes>
</security-config>
