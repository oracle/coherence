<security-config xmlns="http://xmlns.oracle.com/coherence/coherence-security-config"
                 version="1.0">
  <allowed-classes>
    <class name="com.tangosol.coherence.rest.events.MapEventOutput$Type" source="manual"/>
    <class name="com.tangosol.coherence.rest.query.QueryException" source="manual"/>
    <class name="com.tangosol.coherence.rest.util.JsonMap" source="manual"/>
    <class name="com.tangosol.coherence.rest.util.PropertySet" source="manual" executable="true"/>
    <class name="com.tangosol.coherence.rest.util.PropertySpec" source="manual"/>
    <class name="com.tangosol.coherence.rest.util.StaticContent" source="manual"/>
  </allowed-classes>
</security-config>
